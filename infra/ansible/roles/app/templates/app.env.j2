# Managed by Ansible (infra/ansible, values from the vault). Edit there, not here.
{% set public_url = 'https://' ~ domain ~ ('' if https_port | int == 443 else ':' ~ https_port) %}
DJANGO_SECRET_KEY={{ vault_django_secret_key }}
DJANGO_DEBUG=0
# 127.0.0.1: container healthcheck. backend: prometheus scrapes backend:8000.
DJANGO_ALLOWED_HOSTS={{ domain }},127.0.0.1,backend
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS={{ public_url }}
AUTH_COOKIE_SECURE=1
DJANGO_HSTS_SECONDS={{ hsts_max_age }}
DJANGO_HSTS_INCLUDE_SUBDOMAINS={{ 1 if hsts_include_subdomains | bool else 0 }}
API_URL={{ public_url }}
FRONTEND_URL={{ public_url }}/

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://:{{ vault_redis_password }}@redis:6379/0

JWT_SECRET={{ vault_jwt_secret }}
INTRA_CLIENT_ID={{ intra_client_id }}
INTRA_CLIENT_SECRET={{ vault_intra_client_secret | default('') }}
