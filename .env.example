# Read by docker compose itself (not passed to containers). `make env`
# creates .env; container settings live in env/<dev|prod>/*.env.

# Host port of the Django dev server (seed script, /admin), dev only.
BACKEND_PORT=8000
# Your user and group ids: the dev backend runs as you, so files it writes
# into the bind-mounted code (avatars, migrations) belong to you.
HOST_UID=1000
HOST_GID=1000
# Host ports of nginx in prod.
HTTP_PORT=80
HTTPS_PORT=443

# Prod app images (set by infra/scripts/deploy.sh; `make prod` builds :local).
#IMAGE_PREFIX=ghcr.io/bahbibe
#IMAGE_TAG=
