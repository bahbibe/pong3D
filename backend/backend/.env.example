# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 for local development only
DJANGO_DEBUG=0
# Comma separated. Also checked against the Origin of WebSocket handshakes.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Extra origins allowed to call the API with credentials (empty = same origin only)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://localhost:1337
# Set to 0 only if you serve the app over plain HTTP on a host other than localhost
AUTH_COOKIE_SECURE=1
# HSTS max-age in seconds. Keep 0 on localhost; use 31536000 on a real domain.
DJANGO_HSTS_SECONDS=0
# 1 when every subdomain of the prod domain is HTTPS too.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# Public URL of the app (nginx). Used for avatar URLs and the intra OAuth callback.
API_URL=https://localhost:1337
FRONTEND_URL=https://localhost:1337/

# Postgres
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=

# Auth
JWT_SECRET=
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=

REDIS_PORT=6379
